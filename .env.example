# =====================================================================
# STACKY AI CONFIGURATION (.env)
# =====================================================================

# 1. TELEGRAM REMOTE BRIDGE (FOR COLLEGE / AWAY FROM MAC)
# Step 1: Message @BotFather on Telegram -> /newbot -> Paste token below
TELEGRAM_BOT_TOKEN=

# Step 2: Message @userinfobot on Telegram -> Copy your numeric ID below
# (This guarantees ONLY your phone can control your Mac)
TELEGRAM_ALLOWED_USER_ID=

# 2. LLM REASONING (Groq Ultra-Fast Inference / OpenRouter / OpenAI)
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
STACKY_MODEL=openai/gpt-oss-120b
STACKY_DYNAMIC_ROUTING=true

# 3. OPTIONAL: TWILIO PHONE BRIEFING (Voice Calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_PHONE_NUMBER=

# 4. OPTIONAL: EMAIL IMAP / SMTP (Auto-Triage & Drafting)
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_ADDRESS=
EMAIL_PASSWORD=
